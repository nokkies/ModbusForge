<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ModbusForge.Avalonia.ViewModels"
             x:Class="ModbusForge.Avalonia.Views.SignalGeneratorView"
             x:DataType="vm:SignalGeneratorViewModel">

  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
    <TextBlock Text="Waveform:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,8" />
    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Waveforms}" SelectedItem="{Binding Waveform}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8" />

    <TextBlock Text="Period (ms):" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,8" />
    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding PeriodMs}" Minimum="10" Maximum="60000" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" />

    <TextBlock Text="Amplitude:" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,8" />
    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Amplitude}" Minimum="-100000" Maximum="100000" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" />

    <TextBlock Text="Offset:" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,8" />
    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Offset}" Minimum="-100000" Maximum="100000" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" />

    <TextBlock Text="Holding Register Address:" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,8" />
    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Address}" Minimum="0" Maximum="65535" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" />

    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
      <Button Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding !IsRunning}" />
      <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
    </StackPanel>

    <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" Margin="0,0,0,8" />

    <TextBlock Grid.Row="7" Grid.Column="0" Text="Current Value:" VerticalAlignment="Center" Margin="0,0,12,0" />
    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CurrentValue, StringFormat='{}{0:F2}'}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
  </Grid>
</UserControl>
