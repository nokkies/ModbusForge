<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ModbusForge.Avalonia.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="ModbusForge.Avalonia.Views.TrendView"
             x:DataType="vm:TrendViewModel">

  <Grid RowDefinitions="Auto,Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock VerticalAlignment="Center" Text="Retention (min):" />
      <NumericUpDown Value="{Binding RetentionMinutes}" Minimum="1" Maximum="60" Width="80" />
      <TextBlock VerticalAlignment="Center" Text="Sample (ms):" />
      <NumericUpDown Value="{Binding SampleRateMs}" Minimum="50" Maximum="60000" Width="100" />
      <Button Content="Start" Command="{Binding StartCommand}" />
      <Button Content="Stop" Command="{Binding StopCommand}" />
      <Button Content="Remove" Command="{Binding RemoveSelectedCommand}" />
      <Button Content="Clear" Command="{Binding ClearCommand}" />
      <TextBlock VerticalAlignment="Center" Text="Running" Margin="8,0,0,0"
                IsVisible="{Binding IsRunning}" FontWeight="Bold" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock VerticalAlignment="Center" Text="Series:" />
      <ListBox ItemsSource="{Binding SeriesItems}" SelectedItem="{Binding SelectedSeriesItem}" Width="300" Height="60" />
    </StackPanel>

    <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,8">
      <lvc:CartesianChart Series="{Binding Series}"
                          XAxes="{Binding XAxes}"
                          YAxes="{Binding YAxes}"
                          ZoomMode="X" />
    </Border>
  </Grid>
</UserControl>
