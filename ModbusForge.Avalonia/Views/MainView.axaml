<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ModbusForge.Avalonia.ViewModels"
             xmlns:views="clr-namespace:ModbusForge.Avalonia.Views"
             xmlns:models="clr-namespace:ModbusForge.Models;assembly=ModbusForge.Core"
             xmlns:converters="clr-namespace:ModbusForge.Avalonia.Converters"
             x:Class="ModbusForge.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False">

  <UserControl.Resources>
    <converters:NavigationIndexConverter x:Key="NavigationIndexConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="NumericUpDown.compact /template/ ButtonSpinner">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="NumericUpDown.compact /template/ TextBox">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="10" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="16" RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
      <TextBlock VerticalAlignment="Center" Text="Active profile:" />
      <TextBlock VerticalAlignment="Center" Text="{Binding ActiveProfile.DisplayName, FallbackValue='None'}" FontWeight="SemiBold" />
      <TextBlock VerticalAlignment="Center" Text="Mode:" Margin="16,0,0,0" />
      <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" Width="100" Height="24" MinHeight="0" FontSize="10" VerticalAlignment="Center" VerticalContentAlignment="Center" />
      <TextBlock VerticalAlignment="Center" Text="{Binding AddressLabel}" Margin="16,0,0,0" />
      <TextBox Text="{Binding ActiveProfile.IpAddress, FallbackValue='127.0.0.1'}" Width="120" Height="24" MinHeight="0" Padding="4,0" FontSize="10" VerticalAlignment="Center" VerticalContentAlignment="Center" />
      <TextBlock VerticalAlignment="Center" Text="Port:" Margin="16,0,0,0" />
      <NumericUpDown Classes="compact" Value="{Binding ActiveProfile.Port, FallbackValue=502}" Minimum="1" Maximum="65535" Width="120" Height="24" MinHeight="0" Padding="0" FontSize="10" VerticalAlignment="Center" ShowButtonSpinner="False" />
      <TextBlock VerticalAlignment="Center" Text="Unit ID:" Margin="16,0,0,0" IsVisible="{Binding ShowClientFields}" />
      <NumericUpDown Classes="compact" Value="{Binding UnitId}" Minimum="1" Maximum="247" Width="110" Height="24" MinHeight="0" Padding="0" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding ShowClientFields}" ShowButtonSpinner="False" />
      <TextBlock VerticalAlignment="Center" Text="Unit ID(s):" Margin="16,0,0,0" IsVisible="{Binding ShowServerFields}" />
      <TextBox Text="{Binding ServerUnitIds, FallbackValue='1'}" Width="120" Height="24" MinHeight="0" Padding="4,0" FontSize="10" VerticalAlignment="Center" VerticalContentAlignment="Center" IsVisible="{Binding ShowServerFields}" ToolTip.Tip="Comma-separated list (e.g. 1, 2, 5-10)" />
      <TextBlock VerticalAlignment="Center" Text="Active ID:" Margin="16,0,0,0" IsVisible="{Binding ShowServerFields}" />
      <ComboBox x:Name="ActiveUnitIdComboBox"
                ItemsSource="{Binding AvailableUnitIds}"
                SelectedItem="{Binding SelectedUnitId, Mode=OneWay}"
                SelectionChanged="ActiveUnitIdComboBox_SelectionChanged"
                Width="100" Height="24" MinHeight="0" FontSize="10" VerticalAlignment="Center" VerticalContentAlignment="Center"
                IsVisible="{Binding ShowServerFields}" />
      <Button Content="{Binding ToggleConnectionButtonText, FallbackValue='Connect'}" Command="{Binding ToggleConnectionCommand}" Width="100" Height="24" MinHeight="0" Padding="8,0" FontSize="10" VerticalAlignment="Center" VerticalContentAlignment="Center" />
      <TextBlock Text="●" Foreground="#2E8B57" IsVisible="{Binding IsConnected}" VerticalAlignment="Center" FontSize="14" ToolTip.Tip="{Binding ConnectionStatusText}" />
      <TextBlock Text="●" Foreground="#C62828" IsVisible="{Binding IsConnectionErrorVisible}" VerticalAlignment="Center" FontSize="14" ToolTip.Tip="{Binding ConnectionStatusText}" />
      <TextBlock Text="○" Foreground="#777777" IsVisible="{Binding IsDisconnected}" VerticalAlignment="Center" FontSize="14" ToolTip.Tip="{Binding ConnectionStatusText}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="190,*">
      <Border Grid.Column="0" BorderBrush="#40000000" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,12,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Navigation" FontSize="16" FontWeight="SemiBold" Margin="4,2,4,8" />
            <ListBox x:Name="NavigationList"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     SelectedIndex="{Binding SelectedTabIndex, Converter={StaticResource NavigationIndexConverter}, Mode=TwoWay}">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="8,5" />
                  <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
              </ListBox.Styles>
              <ListBoxItem Content="Dashboard" />
              <ListBoxItem Content="Trends" />
              <ListBoxItem Content="Frame Inspector" />
              <ListBoxItem Content="MQTT" />
              <ListBoxItem Content="Script Editor" />
              <ListBoxItem Content="Signal Generator" />
              <ListBoxItem Content="Simulation" />
              <ListBoxItem Content="Registers" Margin="0,16,0,0" />
              <ListBoxItem Content="Input Registers" />
              <ListBoxItem Content="Coils" />
              <ListBoxItem Content="Discrete Inputs" />
              <ListBoxItem Content="Custom Watch" />
              <ListBoxItem Content="Decode" />
              <ListBoxItem Content="Console" />
              <ListBoxItem Content="Debug" />
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <TabControl x:Name="MainTabControl" Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}">
        <TabControl.Styles>
          <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </TabControl.Styles>
      <TabItem x:Name="DashboardTab" Header="Dashboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,*">
            <TextBlock Grid.Row="0" Text="Dashboard" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Border Grid.Row="1" Background="#12000000" CornerRadius="6" Padding="16" Margin="0,0,0,16">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="●" Foreground="#2E8B57" IsVisible="{Binding IsConnected}" />
                  <TextBlock Text="○" Foreground="#777777" IsVisible="{Binding IsDisconnected}" />
                  <TextBlock Text="●" Foreground="#C62828" IsVisible="{Binding IsConnectionErrorVisible}" />
                  <TextBlock Text="{Binding ConnectionStatusText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ActiveProfile.DisplayName, StringFormat='Active profile: {0}', FallbackValue='Active profile: None'}" VerticalAlignment="Center" Margin="16,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Button Content="Connect" Command="{Binding ConnectCommand}" />
                  <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                  <Button Content="Connection Manager" Command="{Binding OpenConnectionManagerCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="2" Background="#12000000" CornerRadius="6" Padding="16" Margin="0,0,0,16">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Quick actions:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Read Holding Registers" Command="{Binding ReadHoldingRegistersCommand}" />
                <Button Content="Open Script Editor" Click="ScriptEditor_Click" />
                <Button Content="Open Trends" Command="{Binding OpenTrendsCommand}" />
              </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#12000000" CornerRadius="6" Padding="16">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Recent connection profiles" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox Grid.Row="1" ItemsSource="{Binding ConnectionProfiles}" SelectedItem="{Binding DashboardSelectedProfile, Mode=TwoWay}" BorderBrush="#40000000" BorderThickness="1">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionProfile">
                      <TextBlock Text="{Binding DisplayName}" Margin="8,4" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TrendTab" Header="Trends" IsVisible="{Binding IsTrendTabVisible}">
        <views:TrendView DataContext="{Binding TrendViewModel}" />
      </TabItem>

      <TabItem x:Name="FrameInspectorTab" Header="Frame Inspector">
        <views:FrameInspectorView DataContext="{Binding FrameInspectorViewModel}" />
      </TabItem>

      <TabItem x:Name="MqttTab" Header="MQTT">
        <views:MqttView DataContext="{Binding MqttViewModel}" />
      </TabItem>

      <TabItem x:Name="ScriptEditorTab" Header="Script Editor">
        <views:ScriptEditorView DataContext="{Binding ScriptEditorViewModel}" />
      </TabItem>

      <TabItem x:Name="SignalGeneratorTab" Header="Signal Generator">
        <views:SignalGeneratorView DataContext="{Binding SignalGeneratorViewModel}" />
      </TabItem>

      <TabItem x:Name="SimulationTab" Header="Simulation" IsVisible="{Binding IsSimulationTabVisible}">
        <views:VisualNodeEditorView DataContext="{Binding VisualNodeEditorViewModel}" />
      </TabItem>

      <TabItem x:Name="RegistersTab" Header="Holding Registers" IsVisible="{Binding IsRegistersTabVisible}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="Start:" />
            <NumericUpDown Value="{Binding HoldingRegisterStart}" Minimum="0" Width="100" />
            <TextBlock VerticalAlignment="Center" Text="Count:" />
            <NumericUpDown Value="{Binding HoldingRegisterCount}" Minimum="1" Maximum="100" Width="80" />
            <Button Content="Read" Command="{Binding ReadHoldingRegistersCommand}" />
            <TextBlock VerticalAlignment="Center" Text="Type:" Margin="16,0,0,0" />
            <ComboBox ItemsSource="{Binding RegisterTypes}" SelectedItem="{Binding RegistersGlobalType}" Width="80" />
            <CheckBox Content="Swap Bytes" IsChecked="{Binding RegistersSwapBytes}" VerticalAlignment="Center" />
            <CheckBox Content="Swap Words" IsChecked="{Binding RegistersSwapWords}" VerticalAlignment="Center" />
            <CheckBox Content="Continuous Read" IsChecked="{Binding HoldingMonitorEnabled}" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" Text="Period (ms):" />
            <NumericUpDown Value="{Binding HoldingMonitorPeriodMs}" Minimum="50" Maximum="60000" Width="100" />
          </StackPanel>

          <DataGrid x:Name="HoldingRegistersGrid" Grid.Row="1"
                    AutoGenerateColumns="False"
                    IsReadOnly="False"
                    GridLinesVisibility="All"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Loaded="HoldingRegistersGrid_Loaded"
                    CellEditEnded="HoldingRegistersGrid_CellEditEnded">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Quick Write" Click="HoldingRegisters_QuickWrite_Click" />
                <MenuItem Header="Add to Custom Watch" Click="HoldingRegisters_AddToCustom_Click" />
                <MenuItem Header="Add to Trend" Click="HoldingRegisters_AddToTrend_Click" />
                <Separator />
                <MenuItem Header="Copy Address" Click="HoldingRegisters_CopyAddress_Click" />
                <MenuItem Header="Copy Value" Click="HoldingRegisters_CopyValue_Click" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="120" />
              <DataGridTemplateColumn Header="Type" Width="80" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.RegisterTypes, RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}}" SelectedItem="{Binding Type}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridCheckBoxColumn Header="Swap Bytes" Binding="{Binding SwapBytes}" Width="100" IsReadOnly="True" />
              <DataGridCheckBoxColumn Header="Swap Words" Binding="{Binding SwapWords}" Width="100" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem x:Name="CoilsTab" Header="Coils" IsVisible="{Binding IsCoilsTabVisible}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="Start:" />
            <NumericUpDown Value="{Binding CoilStart}" Minimum="0" Width="100" />
            <TextBlock VerticalAlignment="Center" Text="Count:" />
            <NumericUpDown Value="{Binding CoilCount}" Minimum="1" Maximum="100" Width="80" />
            <Button Content="Read" Command="{Binding ReadCoilsCommand}" />
            <CheckBox Content="Continuous Read" IsChecked="{Binding CoilsMonitorEnabled}" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" Text="Period (ms):" />
            <NumericUpDown Value="{Binding CoilsMonitorPeriodMs}" Minimum="50" Maximum="60000" Width="100" />
          </StackPanel>

          <DataGrid x:Name="CoilsGrid" Grid.Row="1"
                    AutoGenerateColumns="False"
                    IsReadOnly="False"
                    GridLinesVisibility="All"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    CellEditEnded="CoilsGrid_CellEditEnded">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Quick Write" Click="Coils_QuickWrite_Click" />
                <MenuItem Header="Add to Custom Watch" Click="Coils_AddToCustom_Click" />
                <MenuItem Header="Add to Trend" Click="Coils_AddToTrend_Click" />
                <Separator />
                <MenuItem Header="Copy Address" Click="Coils_CopyAddress_Click" />
                <MenuItem Header="Copy State" Click="Coils_CopyState_Click" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" IsReadOnly="True" />
              <DataGridCheckBoxColumn Header="State" Binding="{Binding State}" Width="80" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem x:Name="InputRegistersTab" Header="Input Registers" IsVisible="{Binding IsInputRegistersTabVisible}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="Start:" />
            <NumericUpDown Value="{Binding InputRegisterStart}" Minimum="0" Width="100" />
            <TextBlock VerticalAlignment="Center" Text="Count:" />
            <NumericUpDown Value="{Binding InputRegisterCount}" Minimum="1" Maximum="100" Width="80" />
            <Button Content="Read" Command="{Binding ReadInputRegistersCommand}" />
            <TextBlock VerticalAlignment="Center" Text="Type:" Margin="16,0,0,0" />
            <ComboBox ItemsSource="{Binding RegisterTypes}" SelectedItem="{Binding InputRegistersGlobalType}" Width="80" />
            <CheckBox Content="Swap Bytes" IsChecked="{Binding InputRegistersSwapBytes}" VerticalAlignment="Center" />
            <CheckBox Content="Swap Words" IsChecked="{Binding InputRegistersSwapWords}" VerticalAlignment="Center" />
            <CheckBox Content="Continuous Read" IsChecked="{Binding InputRegistersMonitorEnabled}" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" Text="Period (ms):" />
            <NumericUpDown Value="{Binding InputRegistersMonitorPeriodMs}" Minimum="50" Maximum="60000" Width="100" />
          </StackPanel>

          <DataGrid x:Name="InputRegistersGrid" Grid.Row="1"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="All"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Add to Custom Watch" Click="InputRegisters_AddToCustom_Click" />
                <MenuItem Header="Add to Trend" Click="InputRegisters_AddToTrend_Click" />
                <Separator />
                <MenuItem Header="Copy Address" Click="InputRegisters_CopyAddress_Click" />
                <MenuItem Header="Copy Value" Click="InputRegisters_CopyValue_Click" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="120" IsReadOnly="True" />
              <DataGridTemplateColumn Header="Type" Width="80" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.RegisterTypes, RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}}" SelectedItem="{Binding Type}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridCheckBoxColumn Header="Swap Bytes" Binding="{Binding SwapBytes}" Width="100" IsReadOnly="True" />
              <DataGridCheckBoxColumn Header="Swap Words" Binding="{Binding SwapWords}" Width="100" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem x:Name="DiscreteInputsTab" Header="Discrete Inputs" IsVisible="{Binding IsDiscreteInputsTabVisible}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="Start:" />
            <NumericUpDown Value="{Binding DiscreteInputStart}" Minimum="0" Width="100" />
            <TextBlock VerticalAlignment="Center" Text="Count:" />
            <NumericUpDown Value="{Binding DiscreteInputCount}" Minimum="1" Maximum="100" Width="80" />
            <Button Content="Read" Command="{Binding ReadDiscreteInputsCommand}" />
            <CheckBox Content="Continuous Read" IsChecked="{Binding DiscreteInputsMonitorEnabled}" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" Text="Period (ms):" />
            <NumericUpDown Value="{Binding DiscreteInputsMonitorPeriodMs}" Minimum="50" Maximum="60000" Width="100" />
          </StackPanel>

          <DataGrid x:Name="DiscreteInputsGrid" Grid.Row="1"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="All"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Add to Custom Watch" Click="DiscreteInputs_AddToCustom_Click" />
                <MenuItem Header="Add to Trend" Click="DiscreteInputs_AddToTrend_Click" />
                <Separator />
                <MenuItem Header="Copy Address" Click="DiscreteInputs_CopyAddress_Click" />
                <MenuItem Header="Copy State" Click="DiscreteInputs_CopyState_Click" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" IsReadOnly="True" />
              <DataGridCheckBoxColumn Header="State" Binding="{Binding State}" Width="80" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem x:Name="CustomWatchTab" Header="Custom Watch" IsVisible="{Binding IsCustomWatchTabVisible}">
        <Grid RowDefinitions="Auto,*" Margin="0,0,0,0">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Add" Command="{Binding AddCustomEntryCommand}" />
            <Button Content="Remove" Command="{Binding RemoveCustomEntryCommand}" />
            <Button Content="Read Selected" Command="{Binding ReadCustomEntryCommand}" />
            <Button Content="Read All" Command="{Binding ReadAllCustomNowCommand}" />
            <Button Content="Write Selected" Command="{Binding WriteCustomEntryCommand}" />
            <Button Content="Save Custom" Command="{Binding SaveCustomCommand}" />
            <Button Content="Load Custom" Command="{Binding LoadCustomCommand}" />
            <CheckBox Content="Monitor" IsChecked="{Binding IsCustomWatchMonitoring}" VerticalAlignment="Center" />
          </StackPanel>

          <DataGrid Grid.Row="1" ItemsSource="{Binding CustomEntries}"
                    SelectedItem="{Binding SelectedCustomEntry}"
                    AutoGenerateColumns="False"
                    IsReadOnly="False"
                    GridLinesVisibility="All">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" />
              <DataGridTemplateColumn Header="Area" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.CustomAreas, RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}}" SelectedItem="{Binding Area, Mode=TwoWay}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.CustomAreas, RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}}" SelectedItem="{Binding Area, Mode=TwoWay}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Type" Width="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.RegisterTypes, RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}}" SelectedItem="{Binding Type, Mode=TwoWay}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.RegisterTypes, RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}}" SelectedItem="{Binding Type, Mode=TwoWay}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120" IsReadOnly="True" />
              <DataGridTextColumn Header="Write Value" Binding="{Binding WriteValue}" Width="120" />
              <DataGridCheckBoxColumn Header="Continuous Write" Binding="{Binding Continuous}" Width="110" />
              <DataGridTextColumn Header="Write Period (ms)" Binding="{Binding PeriodMs}" Width="110" />
              <DataGridCheckBoxColumn Header="Read" Binding="{Binding Monitor}" Width="70" />
              <DataGridTextColumn Header="Read Period (ms)" Binding="{Binding ReadPeriodMs}" Width="110" />
              <DataGridCheckBoxColumn Header="Trend" Binding="{Binding Trend}" Width="70" />
              <DataGridTemplateColumn Header="Actions" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="models:CustomEntry">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Content="Write"
                              Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).WriteCustomNowCommand}"
                              CommandParameter="{Binding}" />
                      <Button Content="Read"
                              Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).ReadCustomNowCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem x:Name="DecodeTab" Header="Decode" IsVisible="{Binding IsDecodeTabVisible}">
        <views:DecodeView DataContext="{Binding DecodeViewModel}" />
      </TabItem>

      <TabItem x:Name="ConsoleTab" Header="Console" IsVisible="{Binding IsConsoleTabVisible}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Clear" Command="{Binding ClearConsoleCommand}" />
            <TextBlock VerticalAlignment="Center" Text="Runtime status and operation messages" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding ConsoleMessages}" />
        </Grid>
      </TabItem>

      <TabItem x:Name="DebugTab" Header="Debug" IsVisible="{Binding IsDebugTabVisible}">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Grid.Row="0" Text="Debug information" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock Grid.Row="1" Text="{Binding DebugSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
              <Button Content="Clear" Command="{Binding ClearDebugCommand}" />
              <TextBlock VerticalAlignment="Center" Text="Recent view-model events" />
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding DebugMessages}" />
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>

  </Grid>
</UserControl>