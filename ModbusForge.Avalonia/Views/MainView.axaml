<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ModbusForge.Avalonia.ViewModels"
             xmlns:views="clr-namespace:ModbusForge.Avalonia.Views"
             x:Class="ModbusForge.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
    <DockPanel Grid.Row="0" LastChildFill="False">
      <Menu DockPanel.Dock="Top">
        <MenuItem Header="_File">
          <MenuItem Header="_Save Project" Command="{Binding SaveProjectCommand}" InputGesture="Ctrl+S" />
          <MenuItem Header="_Load Project" Command="{Binding LoadProjectCommand}" />
          <Separator />
          <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGesture="Ctrl+Q" />
        </MenuItem>
        <MenuItem Header="_Edit">
          <MenuItem Header="_Read" Command="{Binding ReadShortcutCommand}" InputGesture="Ctrl+R" />
          <MenuItem Header="_Refresh" Command="{Binding ReadShortcutCommand}" InputGesture="F5" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="_Trends" Command="{Binding OpenTrendsCommand}" InputGesture="Ctrl+T" />
          <MenuItem Header="_Toggle Theme" Command="{Binding ToggleThemeCommand}" />
        </MenuItem>
        <MenuItem Header="_Tools">
          <MenuItem Header="_Preferences" Command="{Binding OpenPreferencesCommand}" InputGesture="Ctrl+P" />
          <MenuItem Header="_Check for Updates" Command="{Binding CheckForUpdatesCommand}" />
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="_Help" Command="{Binding OpenHelpCommand}" InputGesture="F1" />
          <MenuItem Header="_Keyboard Shortcuts" Command="{Binding OpenKeyboardShortcutsCommand}" />
          <MenuItem Header="_Troubleshooting" Command="{Binding OpenTroubleshootingCommand}" />
          <MenuItem Header="_About ModbusForge" Command="{Binding OpenAboutCommand}" />
        </MenuItem>
      </Menu>
      <TextBlock Text="ModbusForge Avalonia" FontSize="24" FontWeight="Bold" Margin="0,8,0,8" DockPanel.Dock="Top" />
    </DockPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock VerticalAlignment="Center" Text="Active profile:" />
      <TextBlock VerticalAlignment="Center" Text="{Binding ActiveProfile.DisplayName, FallbackValue='None'}" FontWeight="SemiBold" />
      <TextBlock VerticalAlignment="Center" Text="Host:" Margin="16,0,0,0" />
      <TextBlock VerticalAlignment="Center" Text="{Binding ActiveProfile.IpAddress, FallbackValue='127.0.0.1'}" />
      <TextBlock VerticalAlignment="Center" Text="Port:" Margin="16,0,0,0" />
      <TextBlock VerticalAlignment="Center" Text="{Binding ActiveProfile.Port, FallbackValue='502'}" />
      <TextBlock VerticalAlignment="Center" Text="Unit ID:" Margin="16,0,0,0" />
      <NumericUpDown Value="{Binding UnitId}" Minimum="1" Maximum="247" Width="80" />
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock VerticalAlignment="Center" Text="Start:" />
      <NumericUpDown Value="{Binding StartAddress}" Minimum="0" Width="100" />
      <TextBlock VerticalAlignment="Center" Text="Count:" />
      <NumericUpDown Value="{Binding RegisterCount}" Minimum="1" Maximum="100" Width="80" />
      <Button Content="Manage Connections" Click="ManageConnections_Click" />
      <Button Content="Device Scanner" Click="DeviceScanner_Click" />
      <Button Content="Connect" Command="{Binding ConnectCommand}" />
      <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
      <Button Content="Read" Command="{Binding ReadCommand}" />
      <Button Content="Write" Command="{Binding WriteCommand}" />
      <CheckBox Content="Continuous Read" IsChecked="{Binding IsContinuousRead}" VerticalAlignment="Center" />
      <Button Content="Save Project" Command="{Binding SaveProjectCommand}" />
      <Button Content="Load Project" Command="{Binding LoadProjectCommand}" />
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                IsVisible="{Binding IsRegisterArea}">
      <TextBlock VerticalAlignment="Center" Text="Type:" />
      <ComboBox ItemsSource="{Binding RegisterTypes}" SelectedItem="{Binding GlobalType}" Width="80" />
      <CheckBox Content="Swap Bytes" IsChecked="{Binding SwapBytes}" VerticalAlignment="Center" />
      <CheckBox Content="Swap Words" IsChecked="{Binding SwapWords}" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,0,0,8" />

    <TabControl Grid.Row="6" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="Trends">
        <views:TrendView DataContext="{Binding TrendViewModel}" />
      </TabItem>

      <TabItem Header="Frame Inspector">
        <views:FrameInspectorView DataContext="{Binding FrameInspectorViewModel}" />
      </TabItem>

      <TabItem Header="MQTT">
        <views:MqttView DataContext="{Binding MqttViewModel}" />
      </TabItem>

      <TabItem Header="Script Editor">
        <views:ScriptEditorView DataContext="{Binding ScriptEditorViewModel}" />
      </TabItem>

      <TabItem Header="Signal Generator">
        <views:SignalGeneratorView DataContext="{Binding SignalGeneratorViewModel}" />
      </TabItem>

      <TabItem Header="Visual Simulation">
        <views:VisualNodeEditorView DataContext="{Binding VisualNodeEditorViewModel}" />
      </TabItem>

      <TabItem Header="Holding Registers">
        <DataGrid ItemsSource="{Binding HoldingRegisters}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" />
            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="120" />
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
            <DataGridCheckBoxColumn Header="Swap Bytes" Binding="{Binding SwapBytes}" Width="100" />
            <DataGridCheckBoxColumn Header="Swap Words" Binding="{Binding SwapWords}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Coils">
        <DataGrid ItemsSource="{Binding Coils}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" />
            <DataGridCheckBoxColumn Header="State" Binding="{Binding State}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Input Registers">
        <DataGrid ItemsSource="{Binding InputRegisters}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" />
            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="120" />
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
            <DataGridCheckBoxColumn Header="Swap Bytes" Binding="{Binding SwapBytes}" Width="100" />
            <DataGridCheckBoxColumn Header="Swap Words" Binding="{Binding SwapWords}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Discrete Inputs">
        <DataGrid ItemsSource="{Binding DiscreteInputs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" />
            <DataGridCheckBoxColumn Header="State" Binding="{Binding State}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Custom Watch">
        <Grid RowDefinitions="Auto,*" Margin="0,0,0,0">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Add" Command="{Binding AddCustomEntryCommand}" />
            <Button Content="Remove" Command="{Binding RemoveCustomEntryCommand}" />
            <Button Content="Read Selected" Command="{Binding ReadCustomEntryCommand}" />
            <Button Content="Write Selected" Command="{Binding WriteCustomEntryCommand}" />
            <Button Content="Save Custom" Command="{Binding SaveCustomCommand}" />
            <Button Content="Load Custom" Command="{Binding LoadCustomCommand}" />
            <CheckBox Content="Monitor" IsChecked="{Binding IsCustomWatchMonitoring}" VerticalAlignment="Center" />
          </StackPanel>

          <DataGrid Grid.Row="1" ItemsSource="{Binding CustomEntries}"
                    SelectedItem="{Binding SelectedCustomEntry}"
                    AutoGenerateColumns="False"
                    IsReadOnly="False"
                    GridLinesVisibility="All">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80" />
              <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="120" />
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120" IsReadOnly="True" />
              <DataGridTextColumn Header="Write Value" Binding="{Binding WriteValue}" Width="120" />
              <DataGridCheckBoxColumn Header="Continuous" Binding="{Binding Continuous}" Width="90" />
              <DataGridTextColumn Header="Period (ms)" Binding="{Binding PeriodMs}" Width="90" />
              <DataGridCheckBoxColumn Header="Monitor" Binding="{Binding Monitor}" Width="80" />
              <DataGridTextColumn Header="Read Period (ms)" Binding="{Binding ReadPeriodMs}" Width="110" />
              <DataGridCheckBoxColumn Header="Trend" Binding="{Binding Trend}" Width="70" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
