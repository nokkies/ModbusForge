<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:ModbusForge.Avalonia.ViewModels" xmlns:models="clr-namespace:ModbusForge.Models;assembly=ModbusForge.Core" xmlns:shapes="using:Avalonia.Controls.Shapes" xmlns:converters="clr-namespace:ModbusForge.Avalonia.Converters" x:Class="ModbusForge.Avalonia.Views.VisualNodeEditorView" x:DataType="vm:VisualNodeEditorViewModel" Focusable="True">

  <UserControl.Styles>
    <Style Selector="Border.node">
      <Setter Property="BorderBrush" Value="Black"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Background" Value="LightBlue"/>
    </Style>
    <Style Selector="Border.node.selected">
      <Setter Property="BorderBrush" Value="#1976D2"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="Background" Value="#BBDEFB"/>
    </Style>
    <Style Selector="Border.ToolGroup">
      <Setter Property="BorderBrush" Value="#C0C0C0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Background" Value="#F8F8F8"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.ToolGroupHeader">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#505050"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="220,*,300" RowDefinitions="Auto,*">
    <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,4">
      <Border Classes="ToolGroup">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="Nodes" Classes="ToolGroupHeader"/>
          <Button Content="Add" Command="{Binding AddNodeCommand}" ToolTip.Tip="Add a node"/>
          <Button Content="Remove" Command="{Binding RemoveNodeCommand}"/>
          <Button Content="{Binding ConnectButtonText}" Command="{Binding AddConnectionCommand}" Padding="4,2"/>
          <Button Content="Disconnect" Command="{Binding RemoveConnectionCommand}"/>
          <Button Content="Clear" Command="{Binding ClearAllCommand}" ToolTip.Tip="Remove all nodes and connections"/>
        </StackPanel>
      </Border>
      <Border Classes="ToolGroup">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="Connect" Classes="ToolGroupHeader"/>
          <ComboBox ItemsSource="{Binding TargetConnectorOptions}" SelectedItem="{Binding SelectedTargetConnector}" Width="70" ToolTip.Tip="Target connector for connect mode" VerticalAlignment="Center" Padding="4,0"/>
          <TextBlock Text="{Binding ConnectionSourceText}" VerticalAlignment="Center" Margin="2,0" FontSize="11" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
      <Border Classes="ToolGroup">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="Layout" Classes="ToolGroupHeader"/>
          <Button Content="Auto" Command="{Binding AutoLayoutCommand}" ToolTip.Tip="Auto layout nodes"/>
          <Button Content="Align L" Command="{Binding AlignLeftCommand}" ToolTip.Tip="Align selected nodes left"/>
          <Button Content="Align T" Command="{Binding AlignTopCommand}" ToolTip.Tip="Align selected nodes top"/>
          <Button Content="Distrib H" Command="{Binding DistributeHorizontallyCommand}" ToolTip.Tip="Distribute selected nodes horizontally"/>
        </StackPanel>
      </Border>
      <Border Classes="ToolGroup">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="Edit" Classes="ToolGroupHeader"/>
          <Button Content="Undo" Command="{Binding UndoCommand}"/>
          <Button Content="Redo" Command="{Binding RedoCommand}"/>
        </StackPanel>
      </Border>
      <Border Classes="ToolGroup">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="Sim" Classes="ToolGroupHeader"/>
          <Button Content="Run" Command="{Binding RunCommand}"/>
          <Button Content="Stop" Command="{Binding StopCommand}"/>
          <Button Content="Save" Command="{Binding SaveCommand}"/>
          <Button Content="Load" Command="{Binding LoadCommand}"/>
          <Button Content="Demo" Command="{Binding LoadDemoCommand}" ToolTip.Tip="Load demo program"/>
        </StackPanel>
      </Border>
      <Border Classes="ToolGroup">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="View" Classes="ToolGroupHeader"/>
          <Button Content="Tag" Command="{Binding OpenTagBrowserCommand}" ToolTip.Tip="Open tag browser"/>
          <Button Content="Watch" Command="{Binding OpenWatchWindowCommand}" ToolTip.Tip="Open watch window"/>
          <Button Content="−" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out" Padding="4,2"/>
          <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Center"/>
          <Button Content="+" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in" Padding="4,2"/>
          <Button Content="100%" Command="{Binding ResetZoomCommand}" Padding="4,2"/>
        </StackPanel>
      </Border>
      <Border Classes="ToolGroup">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="Grid" Classes="ToolGroupHeader"/>
          <CheckBox Content="Snap" IsChecked="{Binding SnapToGrid}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" ToolTip.Tip="Grid size">
            <NumericUpDown Value="{Binding GridSize}" Minimum="4" Maximum="200" Increment="4" ShowButtonSpinner="False" AllowSpin="False" Width="40" VerticalAlignment="Center" TextAlignment="Center" Padding="2,0"/>
            <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Center">
              <RepeatButton Content="^" FontSize="8" Padding="0" Width="12" Height="12" Click="IncreaseGridSize_Click" ToolTip.Tip="Increase grid size"/>
              <RepeatButton Content="v" FontSize="8" Padding="0" Width="12" Height="12" Click="DecreaseGridSize_Click" ToolTip.Tip="Decrease grid size"/>
            </StackPanel>
          </StackPanel>
          <CheckBox Content="Show" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Classes="ToolGroup">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="Show" Classes="ToolGroupHeader"/>
          <CheckBox Content="Live" IsChecked="{Binding ShowLiveValues}" VerticalAlignment="Center" ToolTip.Tip="Show live values"/>
          <CheckBox Content="Con" IsChecked="{Binding ShowConnectors}" VerticalAlignment="Center" ToolTip.Tip="Show connectors"/>
          <CheckBox Content="Ortho" IsChecked="{Binding UseOrthogonalRouting}" VerticalAlignment="Center" ToolTip.Tip="Use orthogonal connection routing"/>
        </StackPanel>
      </Border>
      <Border Classes="ToolGroup">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="Sel" Classes="ToolGroupHeader"/>
          <Button Content="Watch" Command="{Binding AddSelectedNodeToWatchCommand}" IsEnabled="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Add selected node to watch"/>
          <TextBlock Text="{Binding SelectedNodeCount, StringFormat='Selected: {0}'}" VerticalAlignment="Center" Margin="4,0,0,0" MinWidth="60"/>
        </StackPanel>
      </Border>
      <Border Classes="ToolGroup">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <TextBlock Text="Status" Classes="ToolGroupHeader"/>
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="Bold" MinWidth="120" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
        </StackPanel>
      </Border>
    </WrapPanel>

      <!-- Palette -->
    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,8,0" Grid.Row="1">
      <Grid RowDefinitions="Auto,*,Auto,210">
        <TextBlock Grid.Row="0" Text="Palette" FontWeight="Bold" Margin="0,0,0,8"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding Palette}" SelectedItem="{Binding SelectedPaletteItem}" PointerPressed="Palette_PointerPressed" PointerMoved="Palette_PointerMoved" PointerReleased="Palette_PointerReleased">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:PaletteItem">
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.7"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="Programs (POUs)" FontWeight="Bold" Margin="0,8,0,4"/>
        <Grid Grid.Row="3" RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="4">
            <TextBox Text="{Binding NewProgramName, UpdateSourceTrigger=PropertyChanged}" Watermark="Program/Folder name"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="Create" Command="{Binding CreateProgramCommand}"/>
              <Button Content="Create Folder" Command="{Binding CreateFolderCommand}"/>
              <Button Content="Rename" Command="{Binding RenameItemCommand}" CommandParameter="{Binding SelectedTreeItem}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="Duplicate" Command="{Binding DuplicateProgramCommand}" CommandParameter="{Binding SelectedTreeItem}"/>
              <Button Content="Delete" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding SelectedTreeItem}"/>
            </StackPanel>
          </StackPanel>
          <TreeView x:Name="ProgramTreeView" Grid.Row="1" ItemsSource="{Binding ProgramTree.Items}" SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}" DragDrop.AllowDrop="True" DragDrop.DragOver="TreeView_DragOver" DragDrop.Drop="TreeView_Drop">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
              </Style>
            </TreeView.Styles>
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="models:ProgramFolder" ItemsSource="{Binding Items}">
                <Grid DoubleTapped="TreeItem_DoubleTapped" Background="Transparent">
                  <StackPanel x:Name="ViewPanel" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsRenaming, Converter={x:Static converters:ColorConverters.InverseBoolean}}">
                    <TextBlock Text="" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="[Folder]" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBox x:Name="RenameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding IsRenaming}" Watermark="Folder name" LostFocus="RenameBox_LostFocus" KeyDown="RenameBox_KeyDown"/>
                </Grid>
              </TreeDataTemplate>
              <DataTemplate DataType="models:ProgramModel">
                <Grid DoubleTapped="TreeItem_DoubleTapped" Background="Transparent">
                  <StackPanel x:Name="ViewPanel" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsRenaming, Converter={x:Static converters:ColorConverters.InverseBoolean}}">
                    <TextBlock Text="" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Text=" (" Foreground="#888" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Nodes.Count}" Foreground="#888" VerticalAlignment="Center"/>
                    <TextBlock Text=" nodes)" Foreground="#888" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBox x:Name="RenameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding IsRenaming}" Watermark="Program name" LostFocus="RenameBox_LostFocus" KeyDown="RenameBox_KeyDown"/>
                </Grid>
              </DataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </Grid>
      </Grid>
    </Border>

    <!-- Main editor -->
    <!-- Preview canvas -->
    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="0" Grid.Row="1">
      <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PointerWheelChanged="CanvasScrollViewer_PointerWheelChanged">
        <Canvas x:Name="NodeCanvas" Width="{Binding Config.CanvasWidth}" Height="{Binding Config.CanvasHeight}" Background="#F5F5F5" PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved" PointerReleased="Canvas_PointerReleased" PointerCaptureLost="Canvas_PointerCaptureLost" DragDrop.AllowDrop="True" RenderTransformOrigin="0,0">
          <Canvas.RenderTransform>
            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
          </Canvas.RenderTransform>

          <ItemsControl ItemsSource="{Binding GridLines}" Width="{Binding Config.CanvasWidth}" Height="{Binding Config.CanvasHeight}" IsVisible="{Binding ShowGrid}" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:GridLine">
                <Border Width="{Binding Width}" Height="{Binding Height}" Background="#D9DEE7"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          <ItemsControl.Styles><Style Selector="ContentPresenter" x:DataType="vm:GridLine"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.Styles></ItemsControl>

          <ItemsControl ItemsSource="{Binding Config.Nodes}" Width="{Binding Config.CanvasWidth}" Height="{Binding Config.CanvasHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:VisualNode">
                <Border Width="{Binding Width}" Height="{Binding Height}" Classes="node" Classes.selected="{Binding IsSelected}" CornerRadius="4" PointerPressed="Node_PointerPressed" PointerMoved="Node_PointerMoved" PointerReleased="Node_PointerReleased" PointerCaptureLost="Node_PointerCaptureLost">
                  <Canvas Width="{Binding Width}" Height="{Binding Height}" Background="Transparent">
                    <Grid Canvas.Left="0" Canvas.Top="0" Width="{Binding Width}" Height="{Binding Height}" RowDefinitions="Auto,Auto,*" ClipToBounds="True">
                      <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center"/>
                      <TextBlock Grid.Row="1" Text="{Binding ElementType}" FontSize="10" HorizontalAlignment="Center"/>
                      <TextBox Grid.Row="2" Text="{Binding CurrentValueDouble, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding ShowLiveValues}" HorizontalContentAlignment="Center" GotFocus="LiveValue_GotFocus" LostFocus="LiveValue_LostFocus"/>
                    </Grid>

                    <Canvas Canvas.Left="0" Canvas.Top="0" Width="{Binding Width}" Height="{Binding Height}" IsVisible="{Binding $parent[UserControl].((vm:VisualNodeEditorViewModel)DataContext).ShowConnectors, FallbackValue=True}">
                      <Ellipse Classes="Input1Port" Width="10" Height="10" Fill="#2196F3" Stroke="#1565C0" StrokeThickness="1.5" Cursor="Hand" ToolTip.Tip="Input 1" PointerPressed="Port_PointerPressed">
                        <Canvas.Left>
                          <MultiBinding Converter="{x:Static converters:NodePortPositionConverter.Instance}" ConverterParameter="Input1X">
                            <Binding Path="Width"/>
                            <Binding Path="Height"/>
                          </MultiBinding>
                        </Canvas.Left>
                        <Canvas.Top>
                          <MultiBinding Converter="{x:Static converters:NodePortPositionConverter.Instance}" ConverterParameter="Input1Y">
                            <Binding Path="Width"/>
                            <Binding Path="Height"/>
                          </MultiBinding>
                        </Canvas.Top>
                      </Ellipse>

                      <Ellipse Classes="Input2Port" Width="10" Height="10" Fill="#2196F3" Stroke="#1565C0" StrokeThickness="1.5" Cursor="Hand" ToolTip.Tip="Input 2" IsVisible="{Binding HasSecondInput}" PointerPressed="Port_PointerPressed">
                        <Canvas.Left>
                          <MultiBinding Converter="{x:Static converters:NodePortPositionConverter.Instance}" ConverterParameter="Input2X">
                            <Binding Path="Width"/>
                            <Binding Path="Height"/>
                          </MultiBinding>
                        </Canvas.Left>
                        <Canvas.Top>
                          <MultiBinding Converter="{x:Static converters:NodePortPositionConverter.Instance}" ConverterParameter="Input2Y">
                            <Binding Path="Width"/>
                            <Binding Path="Height"/>
                          </MultiBinding>
                        </Canvas.Top>
                      </Ellipse>

                      <Ellipse Classes="OutputPort" Width="10" Height="10" Fill="#FF9800" Stroke="#E65100" StrokeThickness="1.5" Cursor="Hand" ToolTip.Tip="Output" IsVisible="{Binding HasOutput}" PointerPressed="Port_PointerPressed">
                        <Canvas.Left>
                          <MultiBinding Converter="{x:Static converters:NodePortPositionConverter.Instance}" ConverterParameter="OutputX">
                            <Binding Path="Width"/>
                            <Binding Path="Height"/>
                          </MultiBinding>
                        </Canvas.Left>
                        <Canvas.Top>
                          <MultiBinding Converter="{x:Static converters:NodePortPositionConverter.Instance}" ConverterParameter="OutputY">
                            <Binding Path="Width"/>
                            <Binding Path="Height"/>
                          </MultiBinding>
                        </Canvas.Top>
                      </Ellipse>
                    </Canvas>
                  </Canvas>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          <ItemsControl.Styles><Style Selector="ContentPresenter" x:DataType="models:VisualNode"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.Styles></ItemsControl>

          <ItemsControl ItemsSource="{Binding ConnectionLines}" Width="{Binding Config.CanvasWidth}" Height="{Binding Config.CanvasHeight}" ZIndex="10">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ConnectionLine">
                <Path Data="{Binding PathData}" Stroke="{Binding LineBrush}" StrokeThickness="4" Cursor="Hand" PointerPressed="ConnectionLine_PointerPressed"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Line x:Name="TempConnectionLine" Stroke="#999999" StrokeThickness="2" StrokeDashArray="5,5" IsVisible="False" IsHitTestVisible="False"/>

          <shapes:Rectangle x:Name="MarqueeRectangle" Canvas.Left="{Binding MarqueeX}" Canvas.Top="{Binding MarqueeY}" Width="{Binding MarqueeWidth}" Height="{Binding MarqueeHeight}" Fill="#1E007ACC" Stroke="#007ACC" StrokeThickness="1" StrokeDashArray="4,4" StrokeLineCap="Flat" IsVisible="{Binding MarqueeIsVisible}" IsHitTestVisible="False" ZIndex="1000"/>
        </Canvas>
      </ScrollViewer>
    </Border>
  <Grid Grid.Column="2" RowDefinitions="*,120,170" Grid.Row="1" Margin="8,0,0,0">
      <DataGrid Grid.Row="0" ItemsSource="{Binding Config.Nodes}" SelectedItem="{Binding SelectedNode}" AutoGenerateColumns="False" GridLinesVisibility="All" Margin="0,0,0,8">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
          <DataGridTextColumn Header="Type" Binding="{Binding ElementType}" Width="120" IsReadOnly="True"/>
          <DataGridTextColumn Header="X" Binding="{Binding X}" Width="70"/>
          <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="70"/>
          <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="70"/>
          <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="70"/>
          <DataGridTextColumn Header="Address" Binding="{Binding Input1Address.Address, FallbackValue=''}" Width="80"/>
          <DataGridTextColumn Header="Preset" Binding="{Binding TimerPresetMs}" Width="80"/>
          <DataGridTextColumn Header="Live value" Binding="{Binding CurrentValueDouble, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>

      <DataGrid Grid.Row="1" ItemsSource="{Binding Config.Connections}" SelectedItem="{Binding SelectedConnection}" AutoGenerateColumns="False" GridLinesVisibility="All" Margin="0,0,0,8">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Source" Binding="{Binding SourceNodeId}" Width="*"/>
          <DataGridTextColumn Header="Target" Binding="{Binding TargetNodeId}" Width="*"/>
          <DataGridTextColumn Header="Target port" Binding="{Binding TargetConnector}" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Selected node properties -->
      <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="8" IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ScrollViewer>
          <StackPanel Spacing="4" DataContext="{Binding SelectedNode}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Name:" VerticalAlignment="Center" Width="80"/>
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
              <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="X:" VerticalAlignment="Center" Width="80"/>
              <NumericUpDown Value="{Binding X}" Minimum="0" Maximum="2000" Width="100"/>
              <TextBlock Text="Y:" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <NumericUpDown Value="{Binding Y}" Minimum="0" Maximum="2000" Width="100"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Live value:" VerticalAlignment="Center" Width="80"/>
              <TextBox Text="{Binding CurrentValueDouble, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" GotFocus="LiveValue_GotFocus" LostFocus="LiveValue_LostFocus"/>
              <TextBlock Text="(writes to configured address)" FontSize="10" Opacity="0.65" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Waveform:" VerticalAlignment="Center" Width="80"/>
              <TextBox Text="{Binding Waveform, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
              <TextBlock Text="Period ms:" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <NumericUpDown Value="{Binding PeriodMs}" Minimum="0" Maximum="60000" Width="100"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Amplitude:" VerticalAlignment="Center" Width="80"/>
              <NumericUpDown Value="{Binding Amplitude}" Minimum="-100000" Maximum="100000" Width="100"/>
              <TextBlock Text="Offset:" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <NumericUpDown Value="{Binding Offset}" Minimum="-100000" Maximum="100000" Width="100"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Preset:" VerticalAlignment="Center" Width="80"/>
              <NumericUpDown Value="{Binding TimerPresetMs}" Minimum="0" Maximum="100000" Width="100"/>
              <TextBlock Text="Compare:" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <NumericUpDown Value="{Binding CompareValue}" Minimum="-100000" Maximum="100000" Width="100"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    </Grid>
</UserControl>
