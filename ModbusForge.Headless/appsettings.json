{
  "Logging": {
    "Console": {
      "UseJson": false
    },
    "File": {
      "Path": "logs/modbusforge-headless.log",
      "RollingInterval": "Day",
      "FileSizeLimitBytes": 10485760,
      "RollOnFileSizeLimit": true,
      "RetainedFileCountLimit": 7
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Connection": {
    "Name": "Headless",
    "Mode": "Client",
    "Transport": "Tcp",
    "Host": "127.0.0.1",
    "Port": 502,
    "UnitId": 1,
    "ComPort": "COM1",
    "BaudRate": 9600,
    "Parity": "None",
    "DataBits": 8,
    "StopBits": "One",
    "RtsEnable": false,
    "PreTxDelayMs": 0,
    "PostTxDelayMs": 0
  },
  "Polling": {
    "Area": "HoldingRegister",
    "StartAddress": 0,
    "Count": 10,
    "IntervalMs": 1000
  },
  "Custom": {
    "Path": "",
    "TickMs": 100
  },
  "Mqtt": {
    "Enabled": false,
    "BrokerHost": "localhost",
    "BrokerPort": 1883,
    "ClientId": "ModbusForge-Headless",
    "Username": "",
    "Password": "",
    "TopicTemplate": "modbusforge/{UnitId}/{Tag}",
    "QualityOfService": 0,
    "RetainMessages": false,
    "PublishPeriodMs": 1000
  }
}
