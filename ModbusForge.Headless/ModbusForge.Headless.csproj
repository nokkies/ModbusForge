<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ModbusForge.Headless</AssemblyName>
    <RootNamespace>ModbusForge.Headless</RootNamespace>
    <Version>2026.8.14</Version>
    <AssemblyVersion>2026.8.14</AssemblyVersion>
    <FileVersion>2026.8.14</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModbusForge.Core\ModbusForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
