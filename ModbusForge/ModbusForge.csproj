  <Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>ModbusForge</AssemblyName>
    <RootNamespace>ModbusForge</RootNamespace>
    <Version>2026.7.9</Version>
    <AssemblyVersion>2026.7.9</AssemblyVersion>
    <FileVersion>2026.7.9</FileVersion>
    <LangVersion>12.0</LangVersion>
    <ApplicationIcon>Resources\ModbusForge.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Suppress package compatibility warnings for legacy packages -->
  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- Suppress NU1701 warnings for package compatibility -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>



  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModbusForge.Core\ModbusForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources/ModbusForgeLOGO.png" />
    <Resource Include="Resources/ModbusForge.ico" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ModbusForge.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.0" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <!--
    WPF native runtime libraries (wpfgfx_cor3.dll, etc.) are part of the shared
    Microsoft.WindowsDesktop.App runtime. Publishing them alongside the exe can
    cause a cross-patch mismatch: the managed WPF assemblies are loaded from the
    latest installed shared framework while the native DLLs stay at the patch that
    was used during build, leading to EntryPointNotFoundException on startup.
    Delete them from the publish output so the runtime loads matching natives
    from the shared framework.
  -->
  <Target Name="RemoveWpfNativeLibrariesFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <WpfNativeLibrariesToRemove Include="$(PublishDir)wpfgfx_cor3.dll" />
      <WpfNativeLibrariesToRemove Include="$(PublishDir)PresentationNative_cor3.dll" />
      <WpfNativeLibrariesToRemove Include="$(PublishDir)PenImc_cor3.dll" />
      <WpfNativeLibrariesToRemove Include="$(PublishDir)D3DCompiler_47_cor3.dll" />
      <WpfNativeLibrariesToRemove Include="$(PublishDir)vcruntime140_cor3.dll" />
    </ItemGroup>
    <Delete Files="@(WpfNativeLibrariesToRemove)" ContinueOnError="true" />
  </Target>

</Project>
