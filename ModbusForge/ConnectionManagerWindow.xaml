<ui:FluentWindow x:Class="ModbusForge.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:ModbusForge.Models;assembly=ModbusForge.Core"
        xmlns:ports="clr-namespace:System.IO.Ports;assembly=System.IO.Ports"
        xmlns:behaviors="clr-namespace:ModbusForge.Behaviors"
        Title="Connection Manager" 
        Height="620" 
        Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Resources/ModbusForgeLOGO.png"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <x:Array x:Key="TransportOptions" Type="{x:Type models:TransportType}">
                <models:TransportType>Tcp</models:TransportType>
                <models:TransportType>Rtu</models:TransportType>
                <models:TransportType>Ascii</models:TransportType>
            </x:Array>
            <x:Array x:Key="ParityOptions" Type="{x:Type ports:Parity}">
                <ports:Parity>None</ports:Parity>
                <ports:Parity>Odd</ports:Parity>
                <ports:Parity>Even</ports:Parity>
                <ports:Parity>Mark</ports:Parity>
                <ports:Parity>Space</ports:Parity>
            </x:Array>
            <x:Array x:Key="StopBitsOptions" Type="{x:Type ports:StopBits}">
                <ports:StopBits>One</ports:StopBits>
                <ports:StopBits>OnePointFive</ports:StopBits>
                <ports:StopBits>Two</ports:StopBits>
            </x:Array>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Border Background="{StaticResource FluentBackground}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="{StaticResource FluentPrimary}" Padding="20,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Connection Manager" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource LightMetallicCardBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Connection List -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Connections" Style="{StaticResource FluentSubtitle}" Margin="0,0,0,12"/>

                        <Border Grid.Row="1" 
                                BorderBrush="{StaticResource FluentBorder}" 
                                BorderThickness="1" 
                                CornerRadius="4">
                            <ListBox ItemsSource="{Binding Profiles}"
                                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                     BorderThickness="0"
                                     Background="{StaticResource LightMetallicCardBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource LightMetallicSteelBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource LightMetallicStatusSuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource FluentText}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="Add" Width="70" Margin="0,0,8,0" Command="{Binding AddCommand}" Style="{StaticResource FluentSecondaryButton}"/>
                            <Button Content="Remove" Width="70" Margin="0,0,8,0" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}" Style="{StaticResource FluentSecondaryButton}"/>
                            <Button Content="Clone" Width="70" Command="{Binding CloneCommand}" IsEnabled="{Binding CanClone}" Style="{StaticResource FluentSecondaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Connection Details -->
                <Border Grid.Column="1" Style="{StaticResource FluentCard}">
                    <Grid IsEnabled="{Binding HasSelection}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Name:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource FluentText}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Padding="8,4"
                                 Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Transport:" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Padding="8,4" Margin="0,8,0,0" Width="150" HorizontalAlignment="Left"
                                  ItemsSource="{StaticResource TransportOptions}" 
                                  SelectedItem="{Binding SelectedProfile.Transport, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- TCP settings -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                              Visibility="{Binding SelectedProfile.Transport, Converter={StaticResource TransportTypeToVisibilityConverter}, ConverterParameter=Tcp}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="IP Address:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Padding="8,4"
                                     Text="{Binding SelectedProfile.IpAddress, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Port:" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Padding="8,4" Margin="0,8,0,0" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding SelectedProfile.Port, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>
                        </Grid>

                        <!-- Serial settings -->
                        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0"
                              Visibility="{Binding SelectedProfile.Transport, Converter={StaticResource TransportTypeToVisibilityConverter}, ConverterParameter=Serial}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="COM Port:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource FluentText}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Padding="8,4" Width="150" HorizontalAlignment="Left" IsEditable="True"
                                      ItemsSource="{Binding AvailableSerialPorts}" 
                                      Text="{Binding SelectedProfile.ComPort, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Baud Rate:" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Padding="8,4" Margin="0,8,0,0" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding SelectedProfile.BaudRate, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Text="Data Bits:" Grid.Row="2" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Padding="8,4" Margin="0,8,0,0" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding SelectedProfile.DataBits, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Text="Parity:" Grid.Row="3" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Padding="8,4" Margin="0,8,0,0" Width="150" HorizontalAlignment="Left"
                                      ItemsSource="{StaticResource ParityOptions}" 
                                      SelectedItem="{Binding SelectedProfile.Parity, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Stop Bits:" Grid.Row="4" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Padding="8,4" Margin="0,8,0,0" Width="150" HorizontalAlignment="Left"
                                      ItemsSource="{StaticResource StopBitsOptions}" 
                                      SelectedItem="{Binding SelectedProfile.StopBits, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="RTS:" Grid.Row="5" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                            <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedProfile.RtsEnable}"
                                      Content="Enable RS-485 RTS (always high)"/>

                            <TextBlock Text="RTS Toggle:" Grid.Row="6" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                            <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedProfile.EnableRtsToggle}"
                                      Content="Toggle RTS high only while transmitting"/>

                            <TextBlock Text="Pre Tx (ms):" Grid.Row="7" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Padding="8,4" Margin="0,8,0,0" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding SelectedProfile.PreTxDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Text="Post Tx (ms):" Grid.Row="8" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Padding="8,4" Margin="0,8,0,0" Width="100" HorizontalAlignment="Left"
                                     Text="{Binding SelectedProfile.PostTxDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>
                        </Grid>

                        <TextBlock Text="Unit ID:" Grid.Row="4" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Padding="8,4" Margin="0,8,0,0" Width="100" HorizontalAlignment="Left"
                                 Text="{Binding SelectedProfile.UnitId, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                        <TextBlock Text="Status:" Grid.Row="5" VerticalAlignment="Center" Margin="0,8,12,0" Foreground="{StaticResource FluentText}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" VerticalAlignment="Center"
                                   Text="{Binding SelectedProfile.Status}" FontWeight="SemiBold" Foreground="{StaticResource FluentTextSecondary}"/>

                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Connect" Width="100" Margin="0,0,10,0" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Style="{StaticResource FluentPrimaryButton}"/>
                            <Button Content="Disconnect" Width="100" Margin="0,0,10,0" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}" Style="{StaticResource FluentSecondaryButton}"/>
                            <Button Content="Set as Active" Width="100" Command="{Binding SetActiveCommand}" IsEnabled="{Binding CanSetActive}" Style="{StaticResource FluentSecondaryButton}"/>
                            <ui:ProgressRing Width="24" Height="24" Margin="12,0,0,0" Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" IsIndeterminate="True"/>
                        </StackPanel>

                        <Border Grid.Row="7" Grid.ColumnSpan="2" Background="{StaticResource FluentSurface}" CornerRadius="4" Padding="12" Margin="0,16,0,0" VerticalAlignment="Top">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FluentTextSecondary}">
                                <Run Text="Tip: " FontWeight="SemiBold"/>
                                <Run Text="Choose TCP, RTU, or ASCII transport. For serial, configure the COM port, baud rate, data/stop bits, parity, and RTS. The 'Active' connection is used for the main window operations."/>
                            </TextBlock>
                        </Border>

                        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Save &amp; Close" Width="110" Margin="0,0,10,0" Command="{Binding SaveAndCloseCommand}" Style="{StaticResource FluentPrimaryButton}"/>
                            <Button Content="Cancel" Width="90" Command="{Binding CancelCommand}" Style="{StaticResource FluentSecondaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
