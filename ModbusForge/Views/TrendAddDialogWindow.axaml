<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModbusForge.Avalonia.ViewModels"
        x:Class="ModbusForge.Avalonia.Views.TrendAddDialogWindow"
        xmlns:converters="clr-namespace:ModbusForge.Avalonia.Converters"
        x:DataType="vm:TrendAddDialogViewModel"
        Title="Add Trend Pen"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Window.Resources>
    <converters:BoolNegateConverter x:Key="BoolNegateConverter" />
  </Window.Resources>

  <Grid Margin="20,16" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source:" VerticalAlignment="Center" Margin="0,0,8,10" />
    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
      <RadioButton Content="Register" IsChecked="{Binding IsTagSource, Converter={StaticResource BoolNegateConverter}}" GroupName="Source" />
      <RadioButton Content="Tag" IsChecked="{Binding IsTagSource}" GroupName="Source"
                  ToolTip.Tip="Pick an existing tag from the tag list (bit-packed tags are excluded)" />
    </StackPanel>

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tag:" VerticalAlignment="Center" Margin="0,0,8,8"
               IsVisible="{Binding IsTagSource}" />
    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" HorizontalAlignment="Stretch"
              IsVisible="{Binding IsTagSource}"
              ItemsSource="{Binding TrendableTags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Area:" VerticalAlignment="Center" Margin="0,0,8,8"
               IsVisible="{Binding IsTagSource, Converter={StaticResource BoolNegateConverter}}" />
    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                IsVisible="{Binding IsTagSource, Converter={StaticResource BoolNegateConverter}}">
      <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea, Mode=TwoWay}" Width="180" />
      <TextBlock Text="Address:" VerticalAlignment="Center" Margin="8,0,4,0" />
      <NumericUpDown Value="{Binding Address, Mode=TwoWay}" Minimum="0" Maximum="65535" Width="100" />
    </StackPanel>

    <TextBlock Grid.Row="3" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,8" />
    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             Width="260" Margin="0,0,0,8" HorizontalAlignment="Left"
             ToolTip.Tip="Series name shown in the pen list, legend, and CSV export" />

    <TextBlock Grid.Row="4" Grid.Column="0" Text="Read Period (ms):" VerticalAlignment="Center" Margin="0,0,8,8" />
    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding ReadPeriodMs, Mode=TwoWay}" Minimum="50" Maximum="60000"
                   Width="120" Margin="0,0,0,8" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,10" Opacity="0.6" TextWrapping="Wrap">
      The pen reads the address while a connection is active and appears in the chart as data arrives. Pens are stored per unit and persist with the project.
    </TextBlock>

    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="OK" Command="{Binding OkCommand}" IsDefault="True" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
