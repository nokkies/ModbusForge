<ui:FluentWindow x:Class="ModbusForge.Views.RegisterTemplateImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Import Register Template" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source file -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="File:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="FilePathBox" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Padding="10,4" Click="Browse_Click"/>
        </Grid>

        <!-- Options -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Addressing:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="AddressingCombo" Width="240" SelectionChanged="Addressing_Changed">
                <ComboBoxItem Content="0-based (protocol address)" IsSelected="True"/>
                <ComboBoxItem Content="1-based (address - 1)"/>
                <ComboBoxItem Content="Modicon (40001 / 30001 / 10001)"/>
            </ComboBox>
            <TextBlock Text="Template name:" VerticalAlignment="Center" Margin="20,0,8,0"/>
            <TextBox x:Name="TemplateNameBox" Width="200"/>
            <CheckBox x:Name="SaveTemplateCheck" Content="Save to templates folder" IsChecked="True" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Preview -->
        <DataGrid Grid.Row="2" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Error">
                            <Setter Property="Background" Value="#FFE0E0"/>
                            <Setter Property="Foreground" Value="#8B0000"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                            <Setter Property="Background" Value="#FFF6D6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="50"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                <DataGridTextColumn Header="Tag Name" Binding="{Binding TagName}" Width="170"/>
                <DataGridTextColumn Header="Area" Binding="{Binding RegisterType}" Width="110"/>
                <DataGridTextColumn Header="Source Addr" Binding="{Binding RawAddress}" Width="90"/>
                <DataGridTextColumn Header="Addr" Binding="{Binding Address}" Width="60"/>
                <DataGridTextColumn Header="Bit" Binding="{Binding Bit}" Width="40"/>
                <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="70"/>
                <DataGridTextColumn Header="Words" Binding="{Binding Length}" Width="55"/>
                <DataGridTextColumn Header="Order" Binding="{Binding WordOrder}" Width="85"/>
                <DataGridTextColumn Header="Scale" Binding="{Binding Scale}" Width="55"/>
                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="55"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="75"/>
                <DataGridTextColumn Header="Enum" Binding="{Binding Enum}" Width="120"/>
                <DataGridTextColumn Header="Issues" Binding="{Binding Issues}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="SummaryText" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ImportButton" Content="Import" Width="100" Margin="0,0,10,0"
                    Click="Import_Click" IsDefault="True" IsEnabled="False"/>
            <Button Content="Cancel" Width="100" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
