<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ModbusForge.Avalonia.Views.KeyboardShortcutsWindow"
        Title="Keyboard Shortcuts"
        Width="420"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="DodgerBlue" Padding="20,16">
      <TextBlock Text="Keyboard Shortcuts" FontSize="20" FontWeight="Bold" Foreground="White" />
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
      <StackPanel Spacing="8">
        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="Ctrl + R" FontWeight="Bold" Margin="0,0,16,8" />
            <TextBlock Grid.Column="1" Text="Read selected register area" Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Text="Ctrl + T" FontWeight="Bold" Margin="0,0,16,8" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Open the Trends tab" Margin="0,0,0,8" />

            <TextBlock Grid.Row="2" Text="Ctrl + S" FontWeight="Bold" Margin="0,0,16,8" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Save the current project" Margin="0,0,0,8" />

            <TextBlock Grid.Row="3" Text="F5" FontWeight="Bold" Margin="0,0,16,8" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Refresh / read again" Margin="0,0,0,8" />

            <TextBlock Grid.Row="4" Text="F1" FontWeight="Bold" Margin="0,0,16,8" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Open Help" Margin="0,0,0,8" />

            <TextBlock Grid.Row="5" Text="Ctrl + P" FontWeight="Bold" Margin="0,0,16,8" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="Open Preferences" Margin="0,0,0,8" />

            <TextBlock Grid.Row="6" Text="Ctrl + Q" FontWeight="Bold" Margin="0,0,16,0" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="Exit the application" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="LightGray" Padding="16">
      <Button Content="Close" HorizontalAlignment="Right" Click="Close_Click" />
    </Border>
  </Grid>
</Window>
