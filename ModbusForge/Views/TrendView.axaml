<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ModbusForge.Avalonia.ViewModels"
             xmlns:converters="clr-namespace:ModbusForge.Avalonia.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="ModbusForge.Avalonia.Views.TrendView"
             x:DataType="vm:TrendViewModel">
  <UserControl.Resources>
    <converters:LockToZoomModeConverter x:Key="LockToZoomModeConverter" />
    <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
    <converters:FailingOpacityConverter x:Key="FailingOpacityConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.trendTool">
      <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="TextBlock.trendGroup">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="Button.penRowButton">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- View controls -->
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="trendGroup" VerticalAlignment="Center" Text="View" />
          <Button Classes="trendTool" Content="{Binding FollowingButtonText}" ToolTip.Tip="Follow the newest data" Command="{Binding ToggleFollowingCommand}" />
          <Button Classes="trendTool" Content="Reset" ToolTip.Tip="Reset zoom and pan to the full data range" Command="{Binding ResetViewCommand}" />
          <CheckBox VerticalAlignment="Center" Content="Lock X" ToolTip.Tip="Allow zooming along the time axis only" IsChecked="{Binding LockX}" />
          <CheckBox VerticalAlignment="Center" Content="Lock Y" ToolTip.Tip="Allow zooming along the value axis only" IsChecked="{Binding LockY}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Sampling + data controls -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="trendGroup" VerticalAlignment="Center" Text="Sampling" />
          <TextBlock VerticalAlignment="Center" Text="Retention (min):" ToolTip.Tip="How long trend data is kept" />
          <NumericUpDown Value="{Binding RetentionMinutes}" Minimum="1" Maximum="60" Width="80" />
          <Button Classes="trendTool" Content="Apply" ToolTip.Tip="Apply the retention, trimming old data" Command="{Binding ApplyRetentionCommand}" />
          <Button Classes="trendTool" Content="{Binding LoggingButtonText}" ToolTip.Tip="Start or stop trend logging" Command="{Binding ToggleLoggingCommand}" />
        </StackPanel>
        <Separator VerticalAlignment="Center" Margin="4,2" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="trendGroup" VerticalAlignment="Center" Text="Data" />
          <Button Classes="trendTool" Content="Clear" ToolTip.Tip="Delete all pens (watch entries are kept in Custom Watch)" Command="{Binding ClearCommand}" />
          <Button Classes="trendTool" Content="Export CSV" ToolTip.Tip="Export the selected pen, or all pens if none is selected" Command="{Binding ExportCsvCommand}" />
          <Button Classes="trendTool" Content="Import CSV" ToolTip.Tip="Import a previously exported CSV file" Command="{Binding ImportCsvCommand}" />
          <Button Classes="trendTool" Content="Export PNG" ToolTip.Tip="Save the current chart as a PNG image" Click="ExportPng_Click" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock VerticalAlignment="Center" Text="Running" IsVisible="{Binding IsRunning}" FontWeight="Bold" />
      <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- Chart + pen list -->
    <Grid Grid.Row="3" ColumnDefinitions="*,300" Margin="0,0,0,8">
      <Grid Grid.Column="0">
        <Border BorderBrush="Gray" BorderThickness="1">
          <lvc:CartesianChart x:Name="TrendChart"
                              Series="{Binding Series}"
                              XAxes="{Binding XAxes}"
                              YAxes="{Binding YAxes}"
                              LegendPosition="Right"
                              FindingStrategy="CompareOnlyX">
            <lvc:CartesianChart.ZoomMode>
              <MultiBinding Converter="{StaticResource LockToZoomModeConverter}">
                <Binding Path="LockX" />
                <Binding Path="LockY" />
              </MultiBinding>
            </lvc:CartesianChart.ZoomMode>
          </lvc:CartesianChart>
        </Border>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Opacity="0.55" FontSize="14" IsHitTestVisible="False" Margin="0,0,250,0"
                   IsVisible="{Binding PenCount, Converter={StaticResource CountToBoolConverter}, ConverterParameter=zero}">
          No trend pens yet. Click Add to add a register or tag pen, or import a CSV.
        </TextBlock>
      </Grid>

      <!-- Pen list: every series with per-pen controls, independent of Custom Watch -->
      <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="8,0,0,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="6,6,6,4" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pens" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock VerticalAlignment="Center" Opacity="0.6"
                         Text="{Binding PenCount, StringFormat='({0})'}" />
              <Button Content="Add" Command="{Binding AddPenCommand}"
                      ToolTip.Tip="Add a pen from a register address or an existing tag" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" Opacity="0.6"
                       Text="Rename inline; click the swatch to recolor; the eye toggles the chart line; a red dot marks a pen whose reads are failing (hover for the error)." FontSize="11" TextWrapping="Wrap" />
          </Grid>

          <ListBox ItemsSource="{Binding SeriesItems}"
                   SelectedItem="{Binding SelectedSeriesItem, Mode=TwoWay}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="4,2" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TrendSeriesItem">
                <Grid ColumnDefinitions="24,*,Auto,22,28" Margin="2,0"
                      AutomationProperties.Name="{Binding AutomationLabel}">
                  <Button Grid.Column="0" Classes="penRowButton" Width="18" Height="18"
                          ToolTip.Tip="Cycle color"
                          Command="{Binding CycleColorCommand}">
                    <Border Width="14" Height="14" CornerRadius="3"
                            Background="{Binding ColorBrush}" />
                  </Button>
                  <TextBox Grid.Column="1" Margin="6,0" MinWidth="0"
                           Watermark="name"
                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip.Tip="Pen name (shown in the chart legend)" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0" Spacing="4"
                              IsHitTestVisible="{Binding IsFailing}">
                    <!-- Failure dot: the pen's reads are failing; the tooltip
                         carries the last error. The chart keeps the last good
                         line, so the value stays visible but dimmed. -->
                    <Ellipse Width="8" Height="8" Fill="#C62828" VerticalAlignment="Center"
                             IsVisible="{Binding IsFailing}"
                             ToolTip.Tip="{Binding FailureMessage, StringFormat='Read failing: {0}'}" />
                    <TextBlock VerticalAlignment="Center"
                               Opacity="{Binding IsFailing, Converter={StaticResource FailingOpacityConverter}}"
                               Text="{Binding LastValue, StringFormat='{}{0:0.###}'}" />
                  </StackPanel>
                  <CheckBox Grid.Column="3" VerticalAlignment="Center"
                            IsChecked="{Binding IsVisible, Mode=TwoWay}"
                            ToolTip.Tip="Show this pen on the chart" />
                  <Button Grid.Column="4" Classes="penRowButton" Content="✕" VerticalAlignment="Center"
                          ToolTip.Tip="Remove this pen"
                          Command="{Binding RemoveCommand}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
