<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ModbusForge.Avalonia.ViewModels"
             xmlns:converters="clr-namespace:ModbusForge.Avalonia.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="ModbusForge.Avalonia.Views.TrendView"
             x:DataType="vm:TrendViewModel">
  <UserControl.Resources>
    <converters:LockToZoomModeConverter x:Key="LockToZoomModeConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*">
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <TextBlock VerticalAlignment="Center" Text="Series:" />
        <ComboBox ItemsSource="{Binding SeriesItems}" SelectedItem="{Binding SelectedSeriesItem}" Width="220">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" />
        <Button Content="Color" Command="{Binding ChangeColorCommand}" />
        <Button Content="Reset" Command="{Binding ResetViewCommand}" />
        <Button Content="Play" Command="{Binding PlayCommand}" />
        <Button Content="Pause" Command="{Binding PauseCommand}" />
        <CheckBox VerticalAlignment="Center" Content="Lock X" IsChecked="{Binding LockX}" />
        <CheckBox VerticalAlignment="Center" Content="Lock Y" IsChecked="{Binding LockY}" />
        <TextBlock VerticalAlignment="Center" Text="Retention (min):" />
        <NumericUpDown Value="{Binding RetentionMinutes}" Minimum="1" Maximum="60" Width="80" />
        <Button Content="Apply" Command="{Binding ApplyRetentionCommand}" />
        <TextBlock VerticalAlignment="Center" Text="Sample (ms):" />
        <NumericUpDown Value="{Binding SampleRateMs}" Minimum="50" Maximum="60000" Width="100" />
        <Button Content="Start" Command="{Binding StartCommand}" />
        <Button Content="Stop" Command="{Binding StopCommand}" />
        <Button Content="Clear" Command="{Binding ClearCommand}" />
        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
        <Button Content="Import CSV" Command="{Binding ImportCsvCommand}" />
        <Button Content="Export PNG" Click="ExportPng_Click" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock VerticalAlignment="Center" Text="Running" IsVisible="{Binding IsRunning}" FontWeight="Bold" />
      <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,8">
      <lvc:CartesianChart x:Name="TrendChart"
                          Series="{Binding Series}"
                          XAxes="{Binding XAxes}"
                          YAxes="{Binding YAxes}"
                          LegendPosition="Right"
                          FindingStrategy="CompareOnlyX">
        <lvc:CartesianChart.ZoomMode>
          <MultiBinding Converter="{StaticResource LockToZoomModeConverter}">
            <Binding Path="LockX" />
            <Binding Path="LockY" />
          </MultiBinding>
        </lvc:CartesianChart.ZoomMode>
      </lvc:CartesianChart>
    </Border>
  </Grid>
</UserControl>
