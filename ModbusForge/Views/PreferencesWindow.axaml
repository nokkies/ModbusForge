<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModbusForge.Avalonia.ViewModels"
        x:Class="ModbusForge.Avalonia.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="Preferences"
        Width="560"
        Height="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="DodgerBlue" Padding="20,16">
      <TextBlock Text="Preferences" FontSize="20" FontWeight="Bold" Foreground="White" />
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,16,16,0">
      <StackPanel Spacing="12">
        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4">
          <StackPanel Spacing="8">
            <TextBlock Text="Connection" FontWeight="Bold" FontSize="14" />
            <ToggleSwitch Content="Auto-reconnect on connection loss" IsChecked="{Binding AutoReconnect}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Reconnect interval (ms):" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding AutoReconnectIntervalMs}" Minimum="100" Maximum="60000" Width="120" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4">
          <StackPanel Spacing="8">
            <TextBlock Text="Diagnostics" FontWeight="Bold" FontSize="14" />
            <ToggleSwitch Content="Show diagnostics dialog on connection error" IsChecked="{Binding ShowConnectionDiagnosticsOnError}" />
          </StackPanel>
        </Border>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4">
          <StackPanel Spacing="8">
            <TextBlock Text="Console" FontWeight="Bold" FontSize="14" />
            <ToggleSwitch Content="Enable console logging" IsChecked="{Binding EnableConsoleLogging}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Max console messages:" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding MaxConsoleMessages}" Minimum="1" Maximum="100000" Width="120" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4">
          <StackPanel Spacing="8">
            <TextBlock Text="Performance" FontWeight="Bold" FontSize="14" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Max concurrent trend requests:" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding MaxConcurrentTrendRequests}" Minimum="1" Maximum="64" Width="120" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4">
          <StackPanel Spacing="8">
            <TextBlock Text="Application" FontWeight="Bold" FontSize="14" />
            <ToggleSwitch Content="Confirm before exiting application" IsChecked="{Binding ConfirmOnExit}" />
            <ToggleSwitch Content="Check for updates on startup" IsChecked="{Binding CheckForUpdatesOnStartup}" />
          </StackPanel>
        </Border>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4">
          <StackPanel Spacing="8">
            <TextBlock Text="API (Requires Restart)" FontWeight="Bold" FontSize="14" />
            <ToggleSwitch Content="Enable REST API / MCP" IsChecked="{Binding EnableApi}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="API Port:" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding ApiPort}" Minimum="1" Maximum="65535" Width="120" />
            </StackPanel>
            <ToggleSwitch Content="Enable API documentation (Swagger)" IsChecked="{Binding EnableApiDocumentation}" />
            <ToggleSwitch Content="Require API key for mutations" IsChecked="{Binding EnableApiAuthentication}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="API Key:" VerticalAlignment="Center" />
              <TextBox Text="{Binding ApiKey}" Width="280" IsReadOnly="True" FontFamily="Consolas" />
              <Button Content="New" Command="{Binding RegenerateApiKeyCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4">
          <StackPanel Spacing="8">
            <TextBlock Text="MQTT" FontWeight="Bold" FontSize="14" />
            <ToggleSwitch Content="Enable MQTT publisher" IsChecked="{Binding MqttSettings.Enabled}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Top">
              <TextBlock Text="Host:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,8,8" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MqttSettings.BrokerHost}" Margin="0,0,0,8" />

              <TextBlock Text="Port:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,8" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MqttSettings.BrokerPort}" Minimum="1" Maximum="65535" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" />

              <TextBlock Text="Client ID:" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,8,8" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MqttSettings.ClientId}" Margin="0,0,0,8" />

              <TextBlock Text="Username:" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,8,8" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MqttSettings.Username}" Margin="0,0,0,8" />

              <TextBlock Text="Password:" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,8,8" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MqttSettings.Password}" PasswordChar="*" Margin="0,0,0,8" />

              <TextBlock Text="Topic template:" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,8,8" />
              <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MqttSettings.TopicTemplate}" Margin="0,0,0,8" />

              <TextBlock Text="QoS:" Grid.Row="6" VerticalAlignment="Center" Margin="0,0,8,8" />
              <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding MqttSettings.QualityOfService}" Minimum="0" Maximum="2" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />

              <TextBlock Text="Publish period (ms):" Grid.Row="7" VerticalAlignment="Center" Margin="0,0,8,8" />
              <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding MqttSettings.PublishPeriodMs}" Minimum="0" Maximum="60000" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" />

              <TextBlock Text="Retain:" Grid.Row="8" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ToggleSwitch Grid.Row="8" Grid.Column="1" IsChecked="{Binding MqttSettings.RetainMessages}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="16">
      <Button Content="Save" Command="{Binding SaveCommand}" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>
</Window>
