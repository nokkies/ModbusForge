<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModbusForge.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ModbusForge.Views.PlcEditorView"
             x:DataType="vm:PlcEditorViewModel">

    <UserControl.Styles>
        <Style Selector="Button.pressed">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        </Style>
        <Style Selector="Border.tag-forced">
            <Setter Property="Background" Value="#FFFFE0B2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#FFFF9800"/>
        </Style>
        <Style Selector="TextBlock.active">
            <Setter Property="Foreground" Value="#FF4CAF50"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeControlLowBrush}" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                
                <!-- View Mode Selection -->
                <TextBlock Text="View:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding ViewModes}" 
                         SelectedItem="{Binding SelectedViewMode}"
                         Width="120"/>
                
                <Separator Width="20"/>
                
                <!-- Language-specific tools -->
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsLadderView}">
                    <Button Content="Add Rung" Command="{Binding AddRungCommand}" ToolTip.Tip="Add new ladder rung"/>
                    <Button Content="Add Contact" Command="{Binding AddContactCommand}" ToolTip.Tip="Add contact (NO)"/>
                    <Button Content="Add NC Contact" Command="{Binding AddNcContactCommand}" ToolTip.Tip="Add normally closed contact"/>
                    <Button Content="Add Coil" Command="{Binding AddCoilCommand}" ToolTip.Tip="Add output coil"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsSfcView}">
                    <Button Content="Add Step" Command="{Binding AddStepCommand}" ToolTip.Tip="Add SFC step"/>
                    <Button Content="Add Transition" Command="{Binding AddTransitionCommand}" ToolTip.Tip="Add SFC transition"/>
                    <Button Content="Add Action" Command="{Binding AddActionCommand}" ToolTip.Tip="Add action to selected step"/>
                </StackPanel>
                
                <Separator Width="20"/>
                
                <!-- XEF Import/Export -->
                <Button Content="📥 Import XEF" Command="{Binding ImportXefCommand}" ToolTip.Tip="Import IEC 61131-3 XEF file"/>
                <Button Content="📤 Export XEF" Command="{Binding ExportXefCommand}" ToolTip.Tip="Export to IEC 61131-3 XEF format"/>
                
                <Separator Width="20"/>
                
                <!-- Online Operations -->
                <ToggleButton Content="🟢 Online" IsChecked="{Binding IsOnline}" 
                             Command="{Binding ToggleOnlineCommand}"
                             ToolTip.Tip="Connect/disconnect PLC runtime"/>
                <Button Content="Force" Command="{Binding ForceSelectedTagCommand}" 
                       IsEnabled="{Binding HasSelectedTag}"
                       ToolTip.Tip="Force selected tag value"/>
                <Button Content="Release All" Command="{Binding ReleaseAllForcesCommand}"
                       ToolTip.Tip="Release all forced tags"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="*,300">
            
            <!-- Editor Canvas Area -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    
                    <!-- Ladder Diagram View -->
                    <ItemsControl ItemsSource="{Binding LadderRungs}" IsVisible="{Binding IsLadderView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ThemeControlMidBrush}" 
                                        BorderThickness="1" Margin="4" Padding="8"
                                        CornerRadius="4" Background="{DynamicResource ThemeControlLowBrush}">
                                    <StackPanel>
                                        <!-- Rung Header -->
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding RungNumber}" 
                                                      FontWeight="Bold" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Comment}" 
                                                    Watermark="Rung comment..." Margin="4,0"/>
                                            <TextBlock Grid.Column="2" Text="├───────┤" 
                                                      FontFamily="monospace" FontSize="16"/>
                                        </Grid>
                                        
                                        <!-- Rung Elements (Contacts) -->
                                        <ItemsControl ItemsSource="{Binding Elements}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource ThemeControlMidBrush}"
                                                           BorderThickness="1" Margin="4" Padding="8"
                                                           CornerRadius="4"
                                                           Classes="{Binding IsActive, Converter={StaticResource BoolToClasses}, ConverterParameter=active}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <!-- Contact Symbol -->
                                                            <TextBlock FontFamily="monospace" FontSize="20"
                                                                      Text="{Binding NormallyClosed, Converter={StaticResource ContactSymbolConverter}}"/>
                                                            <!-- Address -->
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Address}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding ElementType}" FontSize="10"
                                                                          Foreground="{DynamicResource ThemeControlMidHighBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Coil Output -->
                                        <StackPanel Orientation="Horizontal" IsVisible="{Binding HasCoil}" Margin="20,0,0,0">
                                            <TextBlock Text="──────(" FontFamily="monospace" FontSize="16"/>
                                            <StackPanel Margin="4,0">
                                                <TextBlock Text="{Binding Coil.Address}" FontWeight="Bold"/>
                                                <TextBlock Text="Coil" FontSize="10"
                                                          Foreground="{DynamicResource ThemeControlMidHighBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text=")──" FontFamily="monospace" FontSize="16"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- SFC Chart View -->
                    <Canvas IsVisible="{Binding IsSfcView}" 
                           Background="{DynamicResource ThemeControlLowestBrush}">
                        <ItemsControl ItemsSource="{Binding SfcSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Panel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerGenerator>
                                <ItemContainerGenerator>
                                    <ItemContainerGenerator.Style>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemContainerGenerator.Style>
                                </ItemContainerGenerator>
                            </ItemsControl.ItemContainerGenerator>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid RowDefinitions="Auto,Auto">
                                        <!-- Step Box -->
                                        <Border Background="{Binding IsActive, Converter={StaticResource BoolToBrush}, 
                                                             TrueValue=#FFC8E6C9, FalseValue=White}"
                                               BorderBrush="{Binding IsInitial, Converter={StaticResource BoolToBrush},
                                                                     TrueValue=#FF2196F3, FalseValue=#FF9E9E9E}"
                                               BorderThickness="2" Width="120" Height="60"
                                               CornerRadius="4">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" 
                                                          HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StepNumber, StringFormat='Step {0}'}"
                                                          FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Actions List -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Actions}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFF5F5F5" BorderBrush="#FFE0E0E0"
                                                           BorderThickness="1" Padding="4,2" Margin="0,2"
                                                           CornerRadius="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding Qualifier}" FontWeight="Bold"
                                                                      FontFamily="monospace" FontSize="10"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="10"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Transitions -->
                        <ItemsControl ItemsSource="{Binding SfcTransitions}">
                            <ItemsControl.ItemContainerGenerator>
                                <ItemContainerGenerator.Style>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemContainerGenerator.Style>
                            </ItemsControl.ItemContainerGenerator>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF3E5F5" BorderBrush="#FFCE93D8"
                                           BorderThickness="1" Width="80" Height="30"
                                           CornerRadius="2">
                                        <TextBlock Text="{Binding Condition}" FontSize="10"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                    
                    <!-- FBD View (existing VisualNodeEditor) -->
                    <ContentControl Content="{Binding FbdView}" IsVisible="{Binding IsFbdView}"/>
                    
                </Grid>
            </ScrollViewer>
            
            <!-- Tag Table Sidebar -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource ThemeControlMidBrush}"
                   BorderThickness="1,0,0,0" Background="{DynamicResource ThemeControlLowestBrush}">
                <Grid RowDefinitions="Auto,*,Auto">
                    
                    <!-- Tag Table Header -->
                    <Border Grid.Row="0" Background="{DynamicResource ThemeControlLowBrush}" Padding="8">
                        <TextBlock Text="Tags" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    
                    <!-- Tag List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,0,0,1"
                                           Classes="{Binding IsForced, Converter={StaticResource BoolToClasses}, ConverterParameter=tag-forced}">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                            
                                            <!-- Tag Name and Type -->
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding DataType}" FontSize="10"
                                                          Foreground="{DynamicResource ThemeControlMidHighBrush}"/>
                                            </StackPanel>
                                            
                                            <!-- Current Value -->
                                            <TextBox Grid.Row="0" Grid.Column="1" Width="80" Margin="4,0"
                                                    Text="{Binding CurrentValue, Mode=TwoWay}"
                                                    IsEnabled="{Binding !IsForced}"
                                                    LostFocus="{Binding OnValueChangedCommand}"/>
                                            
                                            <!-- Force Toggle -->
                                            <ToggleButton Grid.Row="0" Grid.Column="2" Width="50" Margin="4,0"
                                                         Content="Force" IsChecked="{Binding IsForced}"
                                                         Command="{Binding ToggleForceCommand}"
                                                         IsEnabled="{Binding $parent[UserControl].DataContext.IsOnline}"/>
                                            
                                            <!-- On/Off Toggle for BOOL -->
                                            <ToggleButton Grid.Row="0" Grid.Column="3" Width="40" Margin="4,0"
                                                         IsVisible="{Binding DataType, Converter={StaticResource EqualsConverter}, ConverterParameter=BOOL}"
                                                         IsChecked="{Binding CurrentValue}"
                                                         Command="{Binding ToggleValueCommand}"
                                                         ToolTip.Tip="Toggle ON/OFF"/>
                                            
                                            <!-- Address -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                      Text="{Binding FullAddress}" FontSize="10"
                                                      Foreground="{DynamicResource ThemeControlMidHighBrush}"
                                                      Margin="0,4,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Forced Tags Summary -->
                    <Border Grid.Row="2" Background="#FFFFE0B2" Padding="8"
                           IsVisible="{Binding ForcedTags.Count, Converter={StaticResource GreaterThanZeroConverter}}">
                        <StackPanel>
                            <TextBlock Text="⚠️ Forced Tags:" FontWeight="Bold" FontSize="12"/>
                            <ItemsControl ItemsSource="{Binding ForcedTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="4,2" FontSize="10">
                                            <Run Text="{Binding Name}"/><Run Text=" = "/>
                                            <Run Text="{Binding ForcedValue}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    
                </Grid>
            </Border>
            
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeControlLowBrush}" Padding="8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"/>
                <TextBlock Grid.Column="1" Text="{ConnectionStateText}" Margin="0,0,16,0"
                          Classes="{Binding IsOnline, Converter={StaticResource BoolToClasses}, ConverterParameter=active}"/>
                <TextBlock Grid.Column="2" Text="{ActiveViewText}" FontWeight="Bold"/>
            </Grid>
        </Border>
        
    </Grid>
</UserControl>
