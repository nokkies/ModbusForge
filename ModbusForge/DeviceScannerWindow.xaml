<ui:FluentWindow x:Class="ModbusForge.DeviceScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:ModbusForge.Behaviors"
        Title="Device Scanner"
        Height="640"
        Width="980"
        MinHeight="520"
        MinWidth="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Resources/ModbusForgeLOGO.png"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Border Background="{StaticResource FluentBackground}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="{StaticResource FluentPrimary}" Padding="20,16">
                <TextBlock Text="Device Scanner"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource LightMetallicCardBrush}"
                           VerticalAlignment="Center"/>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Scan settings -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Scan Settings" Style="{StaticResource FluentSubtitle}" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Text="Start IP:" VerticalAlignment="Center" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Padding="8,4"
                                     Text="{Binding StartIpAddress, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Text="End IP:" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     Text="{Binding EndIpAddress, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Text="Port from:" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     Text="{Binding StartPort, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Grid.Row="4" Text="Port to:" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     Text="{Binding EndPort, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Grid.Row="5" Text="Unit ID from:" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     Text="{Binding StartUnitId, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Grid.Row="6" Text="Unit ID to:" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     Text="{Binding EndUnitId, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Grid.Row="7" Text="Register type:" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,8,0,0"
                                      ItemsSource="{Binding RegisterTypes}"
                                      SelectedItem="{Binding RegisterType, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="8" Text="Probe address:" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     ToolTip="0-based protocol address used to detect a unit"
                                     Text="{Binding ProbeAddress, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Grid.Row="9" Text="Connect (ms):" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="9" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     Text="{Binding ConnectTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Grid.Row="10" Text="Response (ms):" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="10" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     Text="{Binding ResponseTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Grid.Row="11" Text="Parallel hosts:" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="11" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     Text="{Binding MaxConcurrency, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <CheckBox Grid.Row="12" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                      Content="Read device identification (FC43)"
                                      IsChecked="{Binding ReadDeviceIdentification, Mode=TwoWay}"/>

                            <CheckBox Grid.Row="13" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                      Content="Detect function codes (FC01-FC04)"
                                      ToolTip="Reads one item from each register space to see which read functions a unit implements"
                                      IsChecked="{Binding DetectFunctionCodes, Mode=TwoWay}"/>

                            <CheckBox Grid.Row="14" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                      Content="Scan register range on found devices"
                                      IsChecked="{Binding ScanRegisterRange, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="15" Text="Range start:" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="15" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     IsEnabled="{Binding ScanRegisterRange}"
                                     Text="{Binding RegisterScanStartAddress, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>

                            <TextBlock Grid.Row="16" Text="Range count:" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource FluentText}"/>
                            <TextBox Grid.Row="16" Grid.Column="1" Padding="8,4" Margin="0,8,0,0"
                                     IsEnabled="{Binding ScanRegisterRange}"
                                     Text="{Binding RegisterScanCount, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Results -->
                <Border Grid.Column="1" Style="{StaticResource FluentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="140"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Discovered Devices" Style="{StaticResource FluentSubtitle}" Margin="0,0,0,12"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="160"/>
                                <DataGridTextColumn Header="Unit ID" Binding="{Binding UnitId}" Width="70"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160"/>
                                <DataGridTextColumn Header="Latency (ms)" Binding="{Binding LatencyMs}" Width="90"/>
                                <DataGridTextColumn Header="Function codes" Binding="{Binding SupportedFunctionCodesText}" Width="150"/>
                                <DataGridTextColumn Header="Identification" Binding="{Binding Identification}" Width="200"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="Registers (selected device)" Style="{StaticResource FluentSubtitle}" Margin="0,12,0,8"/>

                        <DataGrid Grid.Row="3"
                                  ItemsSource="{Binding SelectedDevice.Registers}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="90"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="90"/>
                                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource FluentTextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="Scan" Width="90" Margin="0,0,8,0" Command="{Binding StartScanCommand}" Style="{StaticResource FluentPrimaryButton}"/>
                    <Button Content="Stop" Width="90" Margin="0,0,8,0" Command="{Binding CancelScanCommand}" Style="{StaticResource FluentSecondaryButton}"/>
                    <Button Content="Add to Profiles" Width="120" Margin="0,0,8,0" Command="{Binding AddToProfilesCommand}" Style="{StaticResource FluentSecondaryButton}"/>
                    <Button Content="Export CSV" Width="100" Margin="0,0,8,0" Command="{Binding ExportCsvCommand}" Style="{StaticResource FluentSecondaryButton}"/>
                    <Button Content="Clear" Width="80" Margin="0,0,8,0" Command="{Binding ClearResultsCommand}" Style="{StaticResource FluentSecondaryButton}"/>
                    <Button Content="Close" Width="80" Command="{Binding CloseCommand}" Style="{StaticResource FluentSecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
