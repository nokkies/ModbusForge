<ui:FluentWindow x:Class="ModbusForge.AdvancedFunctionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:ModbusForge.Behaviors"
        Title="Advanced Functions"
        Height="640"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Resources/ModbusForgeLOGO.png"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Border Background="{StaticResource FluentBackground}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="{StaticResource FluentPrimary}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Advanced Functions"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource LightMetallicCardBrush}"/>
                    <TextBlock Text="{Binding UnitId, StringFormat='FC22 / FC23 / FC43 on Unit ID {0}'}"
                               Foreground="{StaticResource LightMetallicCardBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="16" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- FC22 -->
                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="FC22 - Mask Write Register" Style="{StaticResource FluentSubtitle}" Margin="0,0,0,8"/>
                            <TextBlock Text="result = (current AND mask) OR (or mask AND NOT and mask)"
                                       Foreground="{StaticResource FluentTextSecondary}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Address:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource FluentText}"/>
                                <TextBox Grid.Column="1" Padding="8,4"
                                         Text="{Binding MaskWriteAddress, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>
                                <TextBlock Grid.Column="2" Text="AND mask:" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource FluentText}"/>
                                <TextBox Grid.Column="3" Padding="8,4"
                                         Text="{Binding AndMask, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>
                                <TextBlock Grid.Column="4" Text="OR mask:" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource FluentText}"/>
                                <TextBox Grid.Column="5" Padding="8,4"
                                         Text="{Binding OrMask, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>
                            </Grid>
                            <Button Content="Mask Write" Width="130" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Command="{Binding MaskWriteCommand}" Style="{StaticResource FluentPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- FC23 -->
                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="FC23 - Read/Write Multiple Registers" Style="{StaticResource FluentSubtitle}" Margin="0,0,0,8"/>
                            <TextBlock Text="The write is performed before the read, in a single transaction."
                                       Foreground="{StaticResource FluentTextSecondary}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Read address:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource FluentText}"/>
                                <TextBox Grid.Column="1" Padding="8,4"
                                         Text="{Binding ReadAddress, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>
                                <TextBlock Grid.Column="2" Text="Count:" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource FluentText}"/>
                                <TextBox Grid.Column="3" Padding="8,4"
                                         Text="{Binding ReadCount, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>
                                <TextBlock Grid.Column="4" Text="Write address:" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource FluentText}"/>
                                <TextBox Grid.Column="5" Padding="8,4"
                                         Text="{Binding WriteAddress, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:NumericTextBoxBehavior.IsNumeric="True" behaviors:NumericTextBoxBehavior.Format="UInteger"/>
                            </Grid>
                            <TextBlock Text="Values to write (comma separated, 0x prefix for hex):"
                                       Margin="0,12,0,4" Foreground="{StaticResource FluentText}"/>
                            <TextBox Padding="8,4" Text="{Binding WriteValues, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Read/Write" Width="130" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Command="{Binding ReadWriteMultipleCommand}" Style="{StaticResource FluentPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- FC43 -->
                    <Border Style="{StaticResource FluentCard}">
                        <StackPanel>
                            <TextBlock Text="FC43 - Read Device Identification" Style="{StaticResource FluentSubtitle}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource FluentText}"/>
                                <ComboBox Width="140" ItemsSource="{Binding DeviceIdCategories}"
                                          SelectedItem="{Binding DeviceIdCategory, Mode=TwoWay}"/>
                                <Button Content="Read Identification" Width="160" Margin="12,0,0,0"
                                        Command="{Binding ReadDeviceIdentificationCommand}" Style="{StaticResource FluentPrimaryButton}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding DeviceIdentificationItems}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      Height="180"
                                      Margin="0,12,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding ObjectId}" Width="60"/>
                                    <DataGridTextColumn Header="Object" Binding="{Binding Name}" Width="160"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource FluentSurface}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource FluentTextSecondary}"/>
                    <Button Grid.Column="1" Content="Close" Width="90" Click="CloseButton_Click"
                            Style="{StaticResource FluentSecondaryButton}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
